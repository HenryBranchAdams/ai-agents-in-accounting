    "getInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,160}$",
          "description": "Stable corpus record ID returned by search or a relationship."
        },
        "include_relations": {
          "default": false,
          "description": "Opt in to bounded one-hop typed relationships.",
          "type": "boolean"
        },
        "relation_direction": {
          "default": "both",
          "type": "string",
          "enum": [
            "out",
            "in",
            "both"
          ]
        },
        "relation_types": {
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cites",
              "cited_by",
              "supports",
              "qualifies",
              "contradicts",
              "supersedes",
              "related"
            ]
          }
        },
        "section": {
          "description": "Exact section ID from get.sections; omit for passages across all sections.",
          "type": "string",
          "maxLength": 160
        },
        "limit": {
          "default": 6,
          "description": "Maximum passages per page; each passage has at most 1600 characters.",
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "cursor": {
          "description": "Opaque next_cursor from the previous page. Reuse every other argument unchanged.",
          "type": "string",
          "maxLength": 1600
        },
        "corpus_version": {
          "description": "Optional corpus version pin. A mismatch fails with VERSION_MISMATCH; omit to read the available snapshot.",
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
