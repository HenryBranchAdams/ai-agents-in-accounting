    "searchInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "naics": {
          "description": "Exact NAICS-US 2022 code. Matches recorded associations only; no automatic descendant coverage.",
          "type": "string",
          "maxLength": 6
        },
        "question_family": {
          "description": "Exact versioned question-family ID from describe. A mapping is a discovery association, not evidence sufficiency.",
          "type": "string",
          "maxLength": 100
        },
        "q": {
          "default": "",
          "description": "All words and double-quoted phrases must match. Case/accent insensitive. Empty query browses records; no semantic expansion.",
          "type": "string",
          "maxLength": 240
        },
        "kind": {
          "description": "Exact record kind key from describe.filters.kinds.",
          "type": "string",
          "maxLength": 80
        },
        "topic": {
          "description": "Exact topic from describe.filters.topics.",
          "type": "string",
          "maxLength": 160
        },
        "industry": {
          "description": "Exact industry from describe.filters.industries.",
          "type": "string",
          "maxLength": 160
        },
        "jurisdiction": {
          "description": "Exact recorded jurisdiction/scope from describe.filters.jurisdictions. These include qualified scopes, not just country names.",
          "type": "string",
          "maxLength": 200
        },
        "framework": {
          "description": "Normalized accounting framework.",
          "type": "string",
          "maxLength": 160
        },
        "entity": {
          "description": "Normalized entity scope.",
          "type": "string",
          "maxLength": 160
        },
        "product": {
          "description": "Normalized product or system.",
          "type": "string",
          "maxLength": 160
        },
        "as_of": {
          "description": "Include records effective on this date where a date is recorded.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source_type": {
          "description": "Exact evidence/source form from describe.filters.source_types; not an authority rating.",
          "type": "string",
          "maxLength": 160
        },
        "review_status": {
          "description": "Exact review status from describe. source-checked is a scoped publisher check, not professional verification.",
          "type": "string",
          "maxLength": 120
        },
        "collection": {
          "description": "Collection ID from describe.filters.collections; restricts to its source_ids and related_ids.",
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,160}$"
        },
        "limit": {
          "default": 8,
          "description": "Maximum compact record cards per page.",
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "cursor": {
          "description": "Opaque next_cursor from the previous page. Reuse every other argument unchanged.",
          "type": "string",
          "maxLength": 1600
        },
        "corpus_version": {
          "description": "Optional corpus version pin. A mismatch fails with VERSION_MISMATCH; omit to read the available snapshot.",
          "type": "string",
          "maxLength": 80
        }
      },
      "additionalProperties": false
    },
