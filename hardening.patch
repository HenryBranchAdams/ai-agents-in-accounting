+#!/usr/bin/env bash
+set -euo pipefail
+
+script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+if [[ "${SITES_ENV_READY:-}" != "1" ]]; then
+  exec "${script_dir}/sites-env.sh" -- "$0" "$@"
+fi
+
+command -v timeout || {
+  echo "build-sites.sh requires GNU timeout." >&2
+  exit 69
+}
+
+vinext="${SITES_PROJECT_ROOT}/node_modules/.bin/vinext"
+if [[ ! -x "${vinext}" ]]; then
+  echo "vinext is unavailable. Run npm run sites:install and wait for it to finish before building." >&2
+  exit 69
+fi
+
+echo "Running bounded vinext build..."
+timeout \
+  --signal=TERM \
+  --kill-after="${SITES_BUILD_KILL_AFTER:-10s}" \
+  "${SITES_BUILD_TIMEOUT:-3m}" \
+  "${vinext}" build
diff --git a/scripts/build-source-archive.mjs b/scripts/build-source-archive.mjs
new file mode 100644
index 0000000..8e5b090
--- /dev/null
+++ b/scripts/build-source-archive.mjs
@@ -0,0 +1,48 @@
+import { createHash } from "node:crypto";
+import { mkdir, readFile, stat, writeFile } from "node:fs/promises";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import release from "../data/release.json" with { type: "json" };
+import { writeZipFromPaths } from "./lib/zip.mjs";
+
+const projectRoot = dirname(dirname(fileURLToPath(import.meta.url)));
+const downloads = join(projectRoot, "public", "downloads");
+const sourceArchive = join(downloads, "accounting-agents-source.zip");
+const sourcePaths = [
+  ".github", ".openai", "app", "benchmark", "bin", "build", "clients", "data", "docs",
+  "LICENSE", "LICENSE-CONTENT.md", "LICENSE-DATA.md", "LICENSES", "AGENTS.md", "ATTRIBUTION.md",
+  "BENCHMARK_SUBMISSIONS.md", "CITATION.cff", "CODE_OF_CONDUCT.md", "CONTRIBUTING.md",
+  "CORRECTIONS.md", "EDITORIAL_POLICY.md", "GOVERNANCE.md", "NOTICE.md", "README.md", "RELEASES.md",
+  "SECURITY.md", "SOURCE_ARCHIVE_NOTICE.md", "packs", "public/images", "scripts", "tests", "worker",
+  "package.json", "package-lock.json", "tsconfig.json", "next.config.ts", "eslint.config.mjs",
+  "postcss.config.mjs", "vite.config.ts", "cloudflare-env.d.ts",
+];
+const assetNames = [
+  "accounting-agent-packs.zip",
+  "accounting-agent-packs.json",
+  "accounting-agent-bench.json",
+  "accounting-agents-source.zip",
+];
+
+await mkdir(downloads, { recursive: true });
+await writeZipFromPaths(sourceArchive, projectRoot, sourcePaths, {
+  timestamp: release.platform.published_at,
+});
+
+const assets = {};
+const checksumLines = [];
+for (const name of assetNames) {
+  const path = join(downloads, name);
+  const bytes = await readFile(path);
+  const digest = createHash("sha256").update(bytes).digest("hex");
+  const size = (await stat(path)).size;
+  checksumLines.push(`${digest}  ${name}`);
+  assets[name] = { sha256: `sha256:${digest}`, bytes: size };
+}
+await writeFile(join(downloads, "SHA256SUMS"), `${checksumLines.join("\n")}\n`, "utf8");
+await writeFile(join(downloads, "archive-digests.json"), `${JSON.stringify({
+  generated_at: release.platform.published_at,
+  assets,
+}, null, 2)}\n`, "utf8");
+
+process.stdout.write(`Built ${assetNames.length} checksummed release assets.\n`);
