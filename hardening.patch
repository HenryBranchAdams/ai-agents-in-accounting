@@ -0,0 +1,117 @@
+import { deflateRawSync } from "node:zlib";
+import { lstat, readdir, readFile, writeFile } from "node:fs/promises";
+import { join, relative, resolve, sep } from "node:path";
+
+const CRC_TABLE = new Uint32Array(256);
+for (let n = 0; n < 256; n += 1) {
+  let value = n;
+  for (let bit = 0; bit < 8; bit += 1) {
+    value = (value & 1) ? (0xedb88320 ^ (value >>> 1)) : (value >>> 1);
+  }
+  CRC_TABLE[n] = value >>> 0;
+}
+
+function crc32(bytes) {
+  let crc = 0xffffffff;
+  for (const byte of bytes) crc = CRC_TABLE[(crc ^ byte) & 0xff] ^ (crc >>> 8);
+  return (crc ^ 0xffffffff) >>> 0;
+}
+
+function dosDateTime(value) {
+  const date = new Date(value);
+  const year = Math.max(1980, Math.min(2107, date.getUTCFullYear()));
+  const dosDate = ((year - 1980) << 9) | ((date.getUTCMonth() + 1) << 5) | date.getUTCDate();
+  const dosTime = (date.getUTCHours() << 11) | (date.getUTCMinutes() << 5) | Math.floor(date.getUTCSeconds() / 2);
+  return { dosDate, dosTime };
+}
+
+function localHeader(entry, offsetDate) {
+  const name = Buffer.from(entry.path, "utf8");
+  const buffer = Buffer.alloc(30);
+  buffer.writeUInt32LE(0x04034b50, 0);
+  buffer.writeUInt16LE(20, 4);
+  buffer.writeUInt16LE(0x0800, 6);
+  buffer.writeUInt16LE(8, 8);
+  buffer.writeUInt16LE(offsetDate.dosTime, 10);
+  buffer.writeUInt16LE(offsetDate.dosDate, 12);
+  buffer.writeUInt32LE(entry.crc, 14);
+  buffer.writeUInt32LE(entry.compressed.length, 18);
+  buffer.writeUInt32LE(entry.data.length, 22);
+  buffer.writeUInt16LE(name.length, 26);
+  buffer.writeUInt16LE(0, 28);
+  return Buffer.concat([buffer, name]);
+}
+
+function centralHeader(entry, offsetDate) {
+  const name = Buffer.from(entry.path, "utf8");
+  const buffer = Buffer.alloc(46);
+  buffer.writeUInt32LE(0x02014b50, 0);
+  buffer.writeUInt16LE(0x0314, 4);
+  buffer.writeUInt16LE(20, 6);
+  buffer.writeUInt16LE(0x0800, 8);
+  buffer.writeUInt16LE(8, 10);
+  buffer.writeUInt16LE(offsetDate.dosTime, 12);
+  buffer.writeUInt16LE(offsetDate.dosDate, 14);
+  buffer.writeUInt32LE(entry.crc, 16);
+  buffer.writeUInt32LE(entry.compressed.length, 20);
+  buffer.writeUInt32LE(entry.data.length, 24);
+  buffer.writeUInt16LE(name.length, 28);
+  buffer.writeUInt16LE(0, 30);
+  buffer.writeUInt16LE(0, 32);
+  buffer.writeUInt16LE(0, 34);
+  buffer.writeUInt16LE(0, 36);
+  buffer.writeUInt32LE(((entry.mode & 0xffff) << 16) >>> 0, 38);
+  buffer.writeUInt32LE(entry.offset, 42);
+  return Buffer.concat([buffer, name]);
+}
+
+function endRecord(entries, centralSize, centralOffset) {
+  const buffer = Buffer.alloc(22);
+  buffer.writeUInt32LE(0x06054b50, 0);
+  buffer.writeUInt16LE(0, 4);
+  buffer.writeUInt16LE(0, 6);
+  buffer.writeUInt16LE(entries.length, 8);
+  buffer.writeUInt16LE(entries.length, 10);
+  buffer.writeUInt32LE(centralSize, 12);
+  buffer.writeUInt32LE(centralOffset, 16);
+  buffer.writeUInt16LE(0, 20);
+  return buffer;
+}
+
+async function collectFile(root, absolutePath, archivePath, entries) {
+  const stats = await lstat(absolutePath);
+  if (stats.isDirectory()) {
+    const children = await readdir(absolutePath);
+    children.sort((left, right) => left.localeCompare(right));
+    for (const child of children) {
+      await collectFile(root, join(absolutePath, child), `${archivePath}/${child}`.replace(/^\//, ""), entries);
+    }
+    return;
+  }
+  if (!stats.isFile()) return;
+  const data = await readFile(absolutePath);
+  entries.push({
+    path: archivePath.split(sep).join("/"),
+    data,
+    compressed: deflateRawSync(data, { level: 9 }),
+    crc: crc32(data),
+    mode: stats.mode,
+    offset: 0,
+  });
+}
+
+export async function writeZipFromPaths(outputPath, rootPath, inputPaths, { timestamp = "1980-01-01T00:00:00.000Z" } = {}) {
+  const root = resolve(rootPath);
+  const entries = [];
+  for (const input of [...inputPaths].sort((left, right) => left.localeCompare(right))) {
+    const absolute = resolve(root, input);
+    const archivePath = relative(root, absolute).split(sep).join("/");
+    await collectFile(root, absolute, archivePath, entries);
+  }
+  entries.sort((left, right) => left.path.localeCompare(right));
+  if (entries.length > 0xffff) throw new RangeError("ZIP64 is not supported by this deterministic archive writer.");
+
+  const date = dosDateTime(timestamp);
+  const localParts = [];
+  let offset = 0;
+  for (const entry of entries) {
+    entry.offset = offset;
+    const header = localHeader(entry, date);
+    localParts.push(header, entry.compressed);
+    offset += header.length + entry.compressed.length;
+  }
+
+  const centralParts = entries.map((entry) => centralHeader(entry, date));
+  const centralSize = centralParts.reduce((total, part) => total + part.length, 0);
+  const archive = Buffer.concat([
+    ...localParts,
+    ...centralParts,
+    endRecord(entries, centralSize, offset),
+  ]);
+  await writeFile(outputPath, archive);
+  return { entries: entries.length, bytes: archive.length };
+}
diff --git a/scripts/validate-release-metadata.mjs b/scripts/validate-release-metadata.mjs
new file mode 100644
index 0000000..729f578
--- /dev/null
+++ b/scripts/validate-release-metadata.mjs
@@ -0,0 +1,53 @@
+import { readFile } from "node:fs/promises";
+import release from "../data/release.json" with { type: "json" };
+import { platformRelease } from "../data/open-source-platform.mjs";
+
+const root = new URL("../", import.meta.url);
+const packageJson = JSON.parse(await readFile(new URL("package.json", root), "utf8"));
+const citation = await readFile(new URL("CITATION.cff", root), "utf8");
+const errors = [];
+
+function validDate(label, value) {
+  if (Number.isNaN(new Date(value).getTime())) errors.push(`${label} is not a valid date: ${value}`);
+}
+
+if (packageJson.version !== release.package_version) {
+  errors.push(`package.json version ${packageJson.version} does not match data/release.json ${release.package_version}`);
+}
+if (platformRelease.id !== release.platform.id) errors.push("platform release ID drift");
+if (platformRelease.published_at !== release.platform.published_at) errors.push("platform publication date drift");
+if (platformRelease.reviewed_at !== release.platform.reviewed_at) errors.push("platform review date drift");
+if (platformRelease.specification_version !== release.platform.specification_version) errors.push("specification version drift");
+if (!citation.includes(`version: "${release.platform.id}"`)) errors.push("CITATION.cff version drift");
+if (!citation.includes(`date-released: "${release.platform.published_at.slice(0, 10)}"`)) errors.push("CITATION.cff release date drift");
+if (!citation.includes('repository-code: "https://github.com/HenryBranchAdams/ai-agents-in-accounting"')) {
+  errors.push("CITATION.cff must identify the GitHub repository as repository-code");
+}
+
+validDate("platform.published_at", release.platform.published_at);
+validDate("corpus.modified_at", release.corpus.modified_at);
+validDate("catalog.modified_at", release.catalog.modified_at);
+for (const [label, value] of [
+  ["corpus.modified_at", release.corpus.modified_at],
+  ["catalog.modified_at", release.catalog.modified_at],
+]) {
+  if (new Date(value) > new Date(release.platform.published_at)) {
+    errors.push(`${label} cannot be later than platform.published_at`);
+  }
+}
+try {
+  const origin = new URL(release.default_site_origin);
+  if (origin.pathname !== "/") errors.push("default_site_origin must not include a path");
+} catch {
+  errors.push("default_site_origin must be an absolute URL");
+}
+
+if (errors.length) {
+  for (const error of errors) process.stderr.write(`- ${error}\n`);
+  process.exitCode = 1;
+} else {
+  process.stdout.write(`Release metadata ${release.platform.id} is internally consistent.\n`);
+}
diff --git a/tests/browser/navigation-and-search.spec.mjs b/tests/browser/navigation-and-search.spec.mjs
new file mode 100644
index 0000000..9073a18
--- /dev/null
+++ b/tests/browser/navigation-and-search.spec.mjs
@@ -0,0 +1,75 @@
+import { readFile } from "node:fs/promises";
+import { expect, test } from "@playwright/test";
+
+const axeSource = await readFile(new URL("../../node_modules/axe-core/axe.min.js", import.meta.url), "utf8");
+
+const representativePages = [
+  "/",
+  "/workflows/record-to-report/wf-r2r-bank-reconciliations",
+  "/resources/src_ifrs15a",
+  "/packs/bank-reconciliation",
+  "/ledgerbench",
+];
+
+test("representative pages render without horizontal viewport overflow", async ({ page }) => {
+  for (const path of representativePages) {
+    await page.goto(path);
+    await expect(page.locator("h1")).toHaveCount(1);
+    const overflow = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth);
+    expect(overflow, `${path} horizontal overflow`).toBeLessThanOrEqual(1);
+  }
+});
+
+
+test("representative pages have no serious or critical axe violations", async ({ page }) => {
+  for (const path of representativePages) {
+    await page.goto(path);
+    await page.addScriptTag({ content: axeSource });
+    const violations = await page.evaluate(async () => {
+      const results = await globalThis.axe.run(document, {
+        resultTypes: ["violations"],
+        runOnly: { type: "tag", values: ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa", "wcag22aa"] },
+      });
+      return results.violations
+        .filter((item) => ["serious", "critical"].includes(item.impact))
+        .map((item) => ({ id: item.id, impact: item.impact, nodes: item.nodes.length }));
+    });
+    expect(violations, `${path} automated accessibility violations`).toEqual([]);
+  }
+});
+
+test("global search uses the public API and remains keyboard accessible", async ({ page }) => {
+  await page.goto("/");
+  await page.keyboard.press(process.platform === "darwin" ? "Meta+K" : "Control+K");
+  const dialog = page.getByRole("dialog", { name: "Search documentation" });
+  await expect(dialog).toBeVisible();
+  const input = dialog.getByRole("searchbox", { name: "Search documentation" });
+  await input.fill("bank reconciliation");
+  await expect(dialog.getByRole("link", { name: /Bank reconciliations/i }).first()).toBeVisible();
+  await page.keyboard.press("ArrowDown");
+  await page.keyboard.press("Escape");
+  await expect(dialog).toBeHidden();
+  await expect(page.getByRole("button", { name: /Search documentation/i })).toBeFocused();
+});
+
+test("mobile navigation exposes the same core destinations", async ({ page }, testInfo) => {
+  test.skip(!testInfo.project.name.includes("phone"), "mobile project only");
+  await page.goto("/");
+  await page.getByText("Menu", { exact: true }).click();
+  await expect(page.getByRole("navigation", { name: "Mobile documentation" })).toBeVisible();
+  for (const label of ["All workflows", "Controls and authority", "Workflow packs", "LedgerBench", "Source library"]) {
+    await expect(page.getByRole("navigation", { name: "Mobile documentation" }).getByRole("link", { name: label })).toBeVisible();
+  }
+});
+
+test("wide tables remain operable within a horizontal scroll region", async ({ page }) => {
+  await page.goto("/machine-access");
+  const wrapper = page.locator(".table-scroll").first();
+  if (await wrapper.count()) {
+    await expect(wrapper).toBeVisible();
+    expect(await wrapper.evaluate((element) => getComputedStyle(element).overflowX)).toMatch(/auto|scroll/);
+  }
+});
