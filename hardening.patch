diff --git a/scripts/check-client-bundle.mjs b/scripts/check-client-bundle.mjs
new file mode 100644
index 0000000..4f5d31a
--- /dev/null
+++ b/scripts/check-client-bundle.mjs
@@ -0,0 +1,32 @@
+import { readdir, stat } from "node:fs/promises";
+import { join, relative } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const root = new URL("../dist/", import.meta.url);
+const rootPath = fileURLToPath(root);
+const totalBudget = Number(process.env.CLIENT_JS_BUDGET_BYTES ?? 5_000_000);
+const chunkBudget = Number(process.env.CLIENT_CHUNK_BUDGET_BYTES ?? 1_000_000);
+const files = [];
+
+async function walk(directory) {
+  for (const entry of await readdir(directory, { withFileTypes: true })) {
+    const path = join(directory, entry.name);
+    if (entry.isDirectory()) {
+      if (entry.name === "server" || entry.name === ".openai") continue;
+      await walk(path);
+    } else if (entry.isFile() && path.endsWith(".js")) {
+      files.push({ path: relative(rootPath, path), bytes: (await stat(path)).size });
+    }
+  }
+}
+
+await walk(rootPath);
+if (!files.length) throw new Error("No client JavaScript files were found under dist/.");
+const total = files.reduce((sum, file) => sum + file.bytes, 0);
+const largest = [...files].sort((left, right) => right.bytes - left.bytes)[0];
+process.stdout.write(`${JSON.stringify({ total_bytes: total, total_budget: totalBudget, largest_chunk: largest, chunk_budget: chunkBudget }, null, 2)}\n`);
+if (total > totalBudget) throw new Error(`Client JavaScript ${total} exceeds ${totalBudget} bytes.`);
+if (largest.bytes > chunkBudget) throw new Error(`Client chunk ${largest.path} is ${largest.bytes} bytes; budget is ${chunkBudget}.`);
