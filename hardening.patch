+const args = new Map();
+for (let index = 2; index < process.argv.length; index += 1) {
+  const value = process.argv[index];
+  if (!value.startsWith("--")) continue;
+  const key = value.slice(2);
+  const next = process.argv[index + 1];
+  if (next && !next.startsWith("--")) {
+    args.set(key, next);
+    index += 1;
+  } else {
+    args.set(key, true);
+  }
+}
+
+const baseUrl = String(args.get("base-url") ?? release.default_site_origin).replace(/\/$/, "");
+const reportPath = String(args.get("report") ?? "source-freshness-report.json");
+const timeoutMs = Number(args.get("timeout-ms") ?? 15000);
+const concurrency = Math.max(1, Number(args.get("concurrency") ?? 12));
+const attempts = Math.max(1, Number(args.get("attempts") ?? 2));
+const maximum = Math.max(1, Number(args.get("max") ?? Number.MAX_SAFE_INTEGER));
+const dryRun = args.has("dry-run");
+const strict = args.has("strict");
+
+async function fetchCatalog() {
+  const records = [];
+  let cursor = null;
+  do {
+    const url = new URL("/api/v1/resources", baseUrl);
+    url.searchParams.set("limit", "200");
+    if (cursor) url.searchParams.set("cursor", cursor);
+    const response = await fetch(url, { headers: { Accept: "application/json" } });
+    if (!response.ok) throw new Error(`Catalog request failed: ${response.status} ${url}`);
+    const payload = await response.json();
+    records.push(...payload.items);
+    cursor = payload.next_cursor;
+  } while (cursor && records.length < maximum);
+  return records.slice(0, maximum);
+}
+
+async function requestRecord(record) {
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), timeoutMs);
+  const target = record.canonical_source_url;
+  try {
+    let response = await fetch(target, {
+      method: "HEAD",
+      redirect: "follow",
+      signal: controller.signal,
+      headers: { "User-Agent": "Accounting-Agents-Source-Verifier/1.0" },
+    });
+    if ([400, 403, 405, 501].includes(response.status)) {
+      response = await fetch(target, {
+        method: "GET",
+        redirect: "follow",
+        signal: controller.signal,
+        headers: {
+          Range: "bytes=0-0",
+          "User-Agent": "Accounting-Agents-Source-Verifier/1.0",
+        },
+      });
+    }
+    return {
+      ok: response.status >= 200 && response.status < 400,
+      status: response.status,
+      final_url: response.url,
+      content_type: response.headers.get("content-type"),
+      redirect_changed: response.url !== target,
+      error: null,
+    };
+  } catch (error) {
+    return {
+      ok: false,
+      status: null,
+      final_url: null,
+      content_type: null,
+      redirect_changed: false,
+      error: error instanceof Error ? error.message : String(error),
+    };
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+async function checkRecord(record) {
+  const base = {
+    id: record.id,
+    title: record.title,
+    source_owner: record.owner,
+    canonical_source_url: record.canonical_source_url,
+    checked_at: new Date().toISOString(),
+  };
+  const history = [];
+  for (let attempt = 1; attempt <= attempts; attempt += 1) {
+    const result = await requestRecord(record);
+    history.push({ attempt, status: result.status, error: result.error });
+    if (result.ok) return { ...base, ...result, attempts: attempt, attempt_history: history };
+    if (attempt < attempts) await new Promise((resolve) => setTimeout(resolve, 500 * attempt));
+  }
+  const last = await Promise.resolve(history.at(-1));
+  return {
+    ...base,
+    ok: false,
+    status: last?.status ?? null,
+    final_url: null,
+    content_type: null,
+    redirect_changed: false,
+    error: last?.error ?? "request failed",
+    attempts,
+    attempt_history: history,
+  };
+}
+
+async function mapConcurrent(records, worker) {
+  const results = new Array(records.length);
+  let nextIndex = 0;
+  await Promise.all(Array.from({ length: Math.min(concurrency, records.length) }, async () => {
+    while (nextIndex < records.length) {
+      const index = nextIndex;
+      nextIndex += 1;
+      results[index] = await worker(records[index]);
+    }
+  }));
+  return results;
+}
+
+if (dryRun) {
+  const report = {
+    schema_version: "1.0",
+    dry_run: true,
+    base_url: baseUrl,
+    timeout_ms: timeoutMs,
+    concurrency,
+    attempts,
+    checked_at: new Date().toISOString(),
+  };
+  await writeFile(reportPath, `${JSON.stringify(report, null, 2)}\n`, "utf8");
+  process.stdout.write(`Source verifier configuration is valid; wrote ${reportPath}.\n`);
+} else {
+  const records = await fetchCatalog();
+  const checks = await mapConcurrent(records, checkRecord);
+  const failures = checks.filter((item) => !item.ok);
+  const redirects = checks.filter((item) => item.redirect_changed);
+  const report = {
+    schema_version: "1.0",
+    catalog_base_url: baseUrl,
+    checked_at: new Date().toISOString(),
+    total_records: checks.length,
+    successful_records: checks.length - failures.length,
+    failed_records: failures.length,
+    redirected_records: redirects.length,
+    attempts_per_source: attempts,
+    note: "This is a point-in-time access check. A source is reported failed only after the configured repeated attempts; failure still does not prove withdrawal or invalidity.",
+    checks,
+  };
+  await writeFile(reportPath, `${JSON.stringify(report, null, 2)}\n`, "utf8");
+  process.stdout.write(`Checked ${checks.length} sources: ${failures.length} failed, ${redirects.length} redirected.\n`);
+  if (strict && failures.length) process.exitCode = 1;
+}
